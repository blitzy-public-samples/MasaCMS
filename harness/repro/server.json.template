{
  "name": "@SERVER_NAME@",
  "openBrowser": false,
  "trayEnable": false,
  "app": {
    "cfengine": "@CFENGINE@",
    "serverHomeDirectory": "@SERVER_HOME@"
  },
  "web": {
    "webroot": "@WEBROOT@",
    "host": "@HOST@",
    "http": {
      "enable": true,
      "port": "@PORT@"
    },
    "ssl": {
      "enable": false
    },
    "rewrites": {
      "enable": true
    },
    "rules": [
      "regex( pattern='^/+(gateway|legacy-fixtures|harness)(/|$)', case-sensitive=false ) and is-directory() -> { error-file( file='/dev/null', response-codes={ 404 } ); response-code( 404 ) }"
    ]
  },
  "jvm": {
    "javaHome": "/usr/lib/jvm/java-17-openjdk-amd64",
    "heapSize": 2048,
    "args": "@JVM_ARGS@"
  }
}
