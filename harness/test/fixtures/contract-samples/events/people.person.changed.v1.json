{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opt2:contract-sample:event:people.person.changed.v1",
  "$comment": "source-sha: 696383140578f8dea3ece26f80cd7bfb370ddf0f",
  "title": "Person changed payload",
  "x-opt2-kind": "state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "userId",
    "siteId",
    "deleted",
    "email",
    "fname",
    "lname"
  ],
  "properties": {
    "userId": {
      "$ref": "#/$defs/cfUuid"
    },
    "siteId": {
      "$ref": "#/$defs/siteId"
    },
    "deleted": {
      "type": "boolean"
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "fname": {
      "type": [
        "string",
        "null"
      ]
    },
    "lname": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "cfUuid": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{16}$"
    },
    "siteId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "localTimestamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3}$"
    }
  }
}
