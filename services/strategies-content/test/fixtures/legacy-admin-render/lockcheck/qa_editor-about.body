			<a id="frontEndToolsModalClose" href="javascript:frontEndProxy.post({cmd:'close'});"><i class="mi-close"></i></a>
			
<div id="alertDialog" title="Alert" class="hide">
	<span id="alertDialogMessage"></span>
</div>


		<div class="main mura-layout-row">
<div id="configuratorContainer">
	<h1 id="configuratorHeader">Select Version to Edit</h1>
	<div id="configurator">
	<div class="load-inline"></div>
	</div>
</div>
<script type="text/javascript">
$(function(){

	if (top.location != self.location) {
		if(jQuery("#ProxyIFrame").length){
			jQuery("#ProxyIFrame").load(
				function(){
					frontEndProxy.post({cmd:'setWidth',width:'configurator'});
				}
			);	
		} else {
			frontEndProxy.post({cmd:'setWidth',width:'configurator'});
		}
	}

	$('#configuratorContainer .load-inline').spin(spinnerArgs2);

	var href = './?muraAction\x3Dcarch.lockcheck\x26destAction\x3Dcarch.edit\x26contenthistid\x3D36C6C74D\x2DDF2F\x2D6E7E\x2DD6AC3A8EFE04FFBE\x26contentid\x3D36C677F7\x2DB80F\x2D69C4\x2D193BDAE11B452798\x26siteid\x3Ddefault\x26homeid\x3D\x26compactDisplay\x3Dtrue';
	var locknode=false;

	$.ajax({
		  url: "./index.cfm?muraAction=carch.draftpromptdata&contentid=36C677F7\x2DB80F\x2D69C4\x2D193BDAE11B452798&siteid=default&targetversion=true&contenthistid=36C6C74D\x2DDF2F\x2D6E7E\x2DD6AC3A8EFE04FFBE&homeid=",
		  context: this,
		  success: function(resp){

			  if (resp.showdialog !== undefined && resp.showdialog === "true"){
				
				$('#configurator').html(resp.message);

				$(".draft-prompt-option").click(function(e){
					e.preventDefault();
					href = href.replace('carch.lockcheck','carch.edit&locknode=' + locknode );
					actionModal(href);
				});

				$("#locknodetoggle").on("change",function(){
					locknode=$(this).is(":checked");
				});

			} else {
				href = href.replace('carch.lockcheck','carch.edit&locknode=' + locknode );
				actionModal(href);
			}
		}
	});
});
</script>
