{"perm":"editor","sortby":"orderno","html":"\n <form novalidate=\"novalidate\" class=\"viewUpdate clearfix\" name=\"viewUpdate\" method=\"post\" action=\"./index.cfm?muraAction=cArch.list&siteid=default&moduleid=00000000000000000000000000000000000&topid=36C941CC-0F55-92B4-76DB40821550D621\">\n\n \t\n\t<div class=\"btn-group\" id=\"sm-modify-view\">\n   <a class=\"btn dropdown-toggle\" data-toggle=\"dropdown\" href=\"\">\n\t Modify View\n\t <span class=\"caret\"></span>\n   </a>\n   <div class=\"dropdown-menu\">\n\t   \n\t   <div>\n\t   <label>Rows Displayed:&nbsp;</label>\n\t   \n \t\t\t\t<input name=\"nextN\" value=\"20\" type=\"text\" class=\"text\" size=\"6\" maxlength=\"4\" />\n\t\t\t\t</div>\n\t\t\t\t<div>\n\n\t\t\t\t<label>Sort Navigation:&nbsp;</label>\n\t\t\t\t<select name=\"sortBy\"  onchange=\"siteManager.setAsSorted();\">\n\t\t\t\t\t\n\t\t\t\t\t \t<option value=\"orderno\" selected>Manual</option>\n\t\t\t\t\t\t<option value=\"releaseDate\" >Release Date</option>\n\t\t\t\t\t\t<option value=\"lastUpdate\" >Last Updated</option>\n\t\t\t\t\t\t<option value=\"created\" >Created</option>\n\t\t\t\t\t\t<option value=\"menuTitle\" >Menu Title</option>\n\t\t\t\t\t\t<option value=\"title\" >Long Title</option>\n\t\t\t\t\t\t<option value=\"rating\" >Rating</option>\n                        \n                            <option value=\"comments\" >Comments</option>\n                        \n\t\t\t\t\t\t\t<option value=\"heroColor\" >Page/Landing - heroColor</option>\n\t\t\t\t\t\t\t\n\t\t\t </select>\n\t\t\t <select name=\"sortDirection\"  onchange=\"siteManager.setAsSorted();\">\n\t\t\t   <option value=\"asc\" selected>Ascending</option>\n\t\t\t   <option value=\"desc\" >Descending</option>\n\t\t\t </select>\n\t\t\t <input type=\"hidden\" name=\"saveSort\" value=\"true\">\n\t\t \n\t\t </div>\n\t\t \n\t\t<div class=\"center\">\n\t\t <input type=\"button\" class=\"btn\" onclick=\"submitForm(document.forms.viewUpdate);\" value=\"Update\" />\n\t\t</div>\n\t   <input type=\"hidden\" name=\"startrow\" value=\"1\">\n\t   <input type=\"hidden\" name=\"orderperm\" value=\"editor\">\n\t   <input type=\"hidden\" id=\"sorted\" name=\"sorted\" value=\"false\">\n   </div>\n </div>\n\n<ul class=\"breadcrumb\">\n\t\t\n\t\t\t<li class=\"\">\n\t\t\t<a \n\t\t\t\thref=\"\" onclick=\"return siteManager.loadSiteManagerInTab(function(){siteManager.loadSiteManager(\'default\',\'00000000000000000000000000000000001\',\'00000000000000000000000000000000000\',\'\',\'\',\'Page\',1)});\"\n\t\t\t><i class=\"mi-file\"></i>Home</a></li>\n\t\t\n\t\t<li class=\"\"><strong>\n\t\t<a \n\t\t\thref=\"\" onclick=\"return siteManager.loadSiteManagerInTab(function(){siteManager.loadSiteManager(\'default\',\'36C941CC-0F55-92B4-76DB40821550D621\',\'00000000000000000000000000000000000\',\'\',\'\',\'Page\',1)});\"\n\t\t><i class=\"mi-file\"></i>Scheduled Page</a></strong></li>\n\t\t</ul> \n <script>\n   $(document).ready(function(){\n\t $(\'#sm-modify-view .dropdown-menu\').click(function(e) {\n\t   e.stopPropagation();\n\t })\n   })\n </script>\n\n \n   <div class=\"help-block\" id=\"sitemgr-reorder\" style=\"display:none\">\n   <i class=\"mi-warning\"></i> Click \"Update\" to save content order: <input type=\"button\" class=\"submit btn pulse\" id=\"submitSort\" onclick=\"submitForm(document.forms.viewUpdate);\" value=\"Update\" />\n   </div>\n \n\n   <!-- Begin Grid Header -->\n   <div class=\"clear-both\"></div>\n   <div class=\"overflow-wrap\">\n   <div class=\"mura-grid stripe\">\n\t <dl class=\"mura-grid-hdr\">\n\t   <dt>\n\t\t   <span class=\"add\"></span>\n\t\t\tTitle\n\t   </dt>\n\t   \n\t\t <dd class=\"objects\">Objects</dd>\n\t\t <dd class=\"display\">Display</dd>\n\t\t <dd class=\"template\">Template</dd>\n\t   \n\t\t <dd class=\"nav\">Nav</dd>\n\t   \n\t   <dd class=\"updated\">Updated</dd>\n\t   <dd class=\"actions\">&nbsp;</dd>\n\t </dl>\n\t <ul id=\"mura-nodes\">\n\t <!-- Begin List of Nodes -->\n\t <li data-siteid=\"default\" data-contentid=\"36C941CC-0F55-