{"perm":"editor","sortby":"orderno","html":"\n <form novalidate=\"novalidate\" class=\"viewUpdate clearfix\" name=\"viewUpdate\" method=\"post\" action=\"./index.cfm?muraAction=cArch.list&siteid=default&moduleid=00000000000000000000000000000000003&topid=00000000000000000000000000000000003\">\n\n \t\n\t<div class=\"btn-group\" id=\"sm-modify-view\">\n   <a class=\"btn dropdown-toggle\" data-toggle=\"dropdown\" href=\"\">\n\t Modify View\n\t <span class=\"caret\"></span>\n   </a>\n   <div class=\"dropdown-menu\">\n\t   \n\t   <div>\n\t   <label>Rows Displayed:&nbsp;</label>\n\t   \n \t\t\t\t<input name=\"nextN\" value=\"20\" type=\"text\" class=\"text\" size=\"6\" maxlength=\"4\" />\n\t\t\t\t</div>\n\t\t\t\t<div>\n\n\t\t\t\t<label>Sort Navigation:&nbsp;</label>\n\t\t\t\t<select name=\"sortBy\"  onchange=\"siteManager.setAsSorted();\">\n\t\t\t\t\t\n\t\t\t\t\t\t<option value=\"orderno\" selected>Manual</option>\n\t\t\t\t\t\t<option value=\"lastUpdate\" >Last Updated</option>\n\t\t\t\t\t\t<option value=\"created\" >Created</option>\n\t\t\t\t\t\t<option value=\"title\" >Long Title</option>\n\t\t\t\t\t\t\n\t\t\t </select>\n\t\t\t <select name=\"sortDirection\"  onchange=\"siteManager.setAsSorted();\">\n\t\t\t   <option value=\"asc\" >Ascending</option>\n\t\t\t   <option value=\"desc\" >Descending</option>\n\t\t\t </select>\n\t\t\t <input type=\"hidden\" name=\"saveSort\" value=\"true\">\n\t\t \n\t\t </div>\n\t\t \n\t\t<div class=\"center\">\n\t\t <input type=\"button\" class=\"btn\" onclick=\"submitForm(document.forms.viewUpdate);\" value=\"Update\" />\n\t\t</div>\n\t   <input type=\"hidden\" name=\"startrow\" value=\"1\">\n\t   <input type=\"hidden\" name=\"orderperm\" value=\"editor\">\n\t   <input type=\"hidden\" id=\"sorted\" name=\"sorted\" value=\"false\">\n   </div>\n </div>\n\n<ul class=\"breadcrumb\">\n\t\t\n\t\t<li class=\"\"><strong>\n\t\t<a \n\t\t\thref=\"\" onclick=\"return siteManager.loadSiteManagerInTab(function(){siteManager.loadSiteManager(\'default\',\'00000000000000000000000000000000003\',\'00000000000000000000000000000000003\',\'\',\'\',\'Module\',1)});\"\n\t\t><i class=\"mi-cog\"></i>Components</a></strong></li>\n\t\t</ul> \n <script>\n   $(document).ready(function(){\n\t $(\'#sm-modify-view .dropdown-menu\').click(function(e) {\n\t   e.stopPropagation();\n\t })\n   })\n </script>\n\n \n   <div class=\"help-block\" id=\"sitemgr-reorder\" style=\"display:none\">\n   <i class=\"mi-warning\"></i> Click \"Update\" to save content order: <input type=\"button\" class=\"submit btn pulse\" id=\"submitSort\" onclick=\"submitForm(document.forms.viewUpdate);\" value=\"Update\" />\n   </div>\n \n\n   <!-- Begin Grid Header -->\n   <div class=\"clear-both\"></div>\n   <div class=\"overflow-wrap\">\n   <div class=\"mura-grid stripe\">\n\t <dl class=\"mura-grid-hdr\">\n\t   <dt>\n\t\t   <span class=\"add\"></span>\n\t\t\tTitle\n\t   </dt>\n\t   \n\t\t  <dd class=\"display\">Display</dd>\n\t   \n\t   <dd class=\"updated\">Updated</dd>\n\t   <dd class=\"actions\">&nbsp;</dd>\n\t </dl>\n\t <ul id=\"mura-nodes\">\n\t <!-- Begin List of Nodes -->\n\t <li data-siteid=\"default\" data-contentid=\"00000000000000000000000000000000003\" data-contenthistid=\"6300ED4A-1320-5CC3-F9D6A2D279E386D0\" data-moduleid=\"00000000000000000000000000000000003\" data-sortby=\"orderno\" data-sortdirection=\"\" class=\"module mura-node-data\" data-csrf=\"&csrf_token=<token>&csrf_token_expires=<token>\">\n\t  \n\t   <dl id=\"top-node\">\n\t   <dt>\n\n\t\t<a class=\"add\" href=\"javascript:;\" onclick=\"siteManager.showMenu(\'newContentMenu\',\'editor\',this,\'00000000000000000000000000000000003\',\'00000000000000000000000000000000003\',\'00000000000000000000000000000000END\',\'default\',\'Module\',\'00000000000000000000000000000000003\');\"><i class=\"mi-ellipsis-v\"></i></a>\n\n\t\t \n\t\t   <a class=\"title\" >\n\t\t <i class=\"icon-mura-module default\"></i> Components\n\t\t   </a>\n\t   </dt>\n\t  \n\t\t <dd class=\"display\">\n\n\t\t\n\t\t\t   <i class=\"mi-check\" title=\"Yes\"></i><span>Yes</span>\n\t\t\t </a>\n\t </dd>\n\t  \n\t\t\t <dd class=\"updated\"></dd>\n\t   \n\t   \n\t  <dd class=\"actions\">\n\t\t<ul>\n\t\t\n  \t\t<li class=\"edit disabled\"><a><i class=\"mi-pencil\"></i></a></li>\n      \n          <li class=\"import\"><a title=\"Import\"  href=\"./?muraAction=cArch.importcomponent&siteid=default\"><i class=\"mi-upload\"></i></a></li>\n      \n\t\t  <li class=\"version-history disabled\"><a><i class=\"mi-history\"></i></a></li>\n  \t\t\n  \t\t  <li class=\"permissions\"><a title=\"Permissions\" href=\"./?muraAction=cPerm.main&contentid=00000000000000000000000000000000003&parentid=&topid=00000000000000000000000000000000003&siteid=default&moduleid=00000000000000000000000000000000003&type=Module\"><i class=\"mi-group\"></i></a></li>\n  \t\t\n  \t\t<li class=\"delete disabled\"><a><i class=\"mi-trash\"></i></a></li>\n\t\t\n\t\t </ul></dd>\n\t   </dl>\n\n\t   \n\t   </li>\n\t   </ul>\n\t </div>\n\t </div> <!-- /.overflow-wrap -->\n\t <div class=\"clear=both\"></div>\n </form>\n "}