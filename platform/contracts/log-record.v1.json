{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opt2:platform:log-record:v1",
  "$comment": "source-sha: 696383140578f8dea3ece26f80cd7bfb370ddf0f",
  "title": "OPT-2 log record v1",
  "description": "Structured JSON log line emitted by @opt2/platform/logging and ingested by Cloud Logging.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "severity",
    "message",
    "service",
    "version",
    "env"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "pattern": "^([0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[048]|[2468][048]|[13579][26])00)-02-29)T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "severity": {
      "description": "Cloud Logging severity.",
      "type": "string",
      "enum": [
        "DEFAULT",
        "DEBUG",
        "INFO",
        "NOTICE",
        "WARNING",
        "ERROR",
        "CRITICAL",
        "ALERT",
        "EMERGENCY"
      ]
    },
    "message": {
      "type": "string"
    },
    "service": {
      "description": "Emitting process, for example people or gateway.",
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "env": {
      "type": "string",
      "enum": [
        "local",
        "cloud"
      ]
    },
    "traceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "spanId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "traceSampled": {
      "type": "boolean"
    },
    "tenantId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "requestId": {
      "type": "string"
    },
    "eventId": {
      "type": "string"
    },
    "route": {
      "type": "string"
    },
    "httpMethod": {
      "type": "string"
    },
    "statusCode": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "latencyMs": {
      "type": "number",
      "minimum": 0
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "message"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "stack": {
          "type": "string"
        }
      }
    },
    "logging.googleapis.com/trace": {
      "type": "string",
      "pattern": "^projects/[^/]+/traces/[0-9a-f]{32}$"
    },
    "logging.googleapis.com/spanId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "logging.googleapis.com/trace_sampled": {
      "type": "boolean"
    }
  }
}
