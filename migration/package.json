{
  "name": "@opt2/migration",
  "version": "1.0.0",
  "private": true,
  "description": "OPT-2 migration orchestrator CLI and service",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "22.23.4"
  },
  "packageManager": "npm@11.21.0",
  "bin": {
    "opt2-migrate": "dist/cli.js",
    "opt2-db": "dist/db-bootstrap/cli.js",
    "opt2-ops": "dist/quiesce/cli.js"
  },
  "scripts": {
    "postinstall": "npm ci --prefix ../platform && npm run build --prefix ../platform",
    "generate": "openapi-typescript contracts/openapi.yaml -o src/generated/openapi.ts && openapi-typescript ../gateway/contracts/openapi.yaml -o src/generated/clients/gateway.ts && openapi-typescript ../services/strategies-content/contracts/openapi.yaml -o src/generated/clients/strategies-content.ts",
    "prebuild": "npm run generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js serve",
    "test": "vitest run --coverage",
    "test:contract": "vitest run test/contract",
    "test:security": "vitest run test/security",
    "auth:matrix": "node node_modules/@opt2/platform/dist/auth/cli.js matrix --app dist/server.js --export buildApp"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "1.12.1",
    "@google-cloud/pubsub": "6.3.2",
    "@opt2/platform": "file:../platform",
    "mssql": "12.7.13",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
